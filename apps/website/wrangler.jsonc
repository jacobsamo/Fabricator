{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fabricator",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
